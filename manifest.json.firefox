{
  "manifest_version": 2,
  "name": "Copy as Markdown",
  "version": "2.0.2",
  "description": "Right-click selected text to copy as Markdown format, or export it as a PDF",
  
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  
  "background": {
    "scripts": ["background.js"]
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "content.js"
      ]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "copyAsMarkdown@fxdq.net",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  
  "icons": {
    "48": "48.png"
  }
}
